generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("HR") // "ADMIN", "HR", "INTERVIEWER"
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Company {
  id          String  @id @default(uuid())
  name        String
  ownerName   String
  email       String  @unique
  phone       String?
  country     String  @default("Việt Nam")
  language    String  @default("Tiếng Việt")
  size        String  @default("1 - 5 nhân viên")
  purpose     String  @default("Sử dụng cho công ty của tôi")
  logoUrl     String?
  address     String?
  users       User[]
  employees   Employee[]
  createdAt   DateTime @default(now())
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  position   String   // Chức danh / Vị trí công việc
  department String   // Phòng ban
  managerId  String?  // Quản lý trực tiếp (FK tự tham chiếu)
  manager    Employee? @relation("ManagerRelation", fields: [managerId], references: [id])
  reports    Employee[] @relation("ManagerRelation")
  avatarUrl  String?
  workAddress String?
  workSchedule String? // JSON string: {"mon": true, "tue": true, ...}
  status     String   @default("active") // "active", "inactive"
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
}

model Job {
  id           String        @id @default(uuid())
  title        String
  department   String
  description  String
  requirements String
  salaryRange  String
  status       String        @default("Open") // "Open", "Closed", "Draft"
  toRecruit    Int           @default(1)
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Candidate {
  id           String        @id @default(uuid())
  fullName     String
  email        String
  phone        String
  cvPath       String?
  rawCvText    String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id            String     @id @default(uuid())
  jobId         String
  job           Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  matchScore    Float?
  matchSummary  String?
  missingSkills String?
  status        String     @default("Applied")
  questions     Question[]
  appliedAt     DateTime   @default(now())
}

model Question {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionText  String
  category      String?
}

model RecruitmentStage {
  id       String @id @default(uuid())
  name     String
  order    Int
  color    String @default("#6366f1")
}

model EmailTemplate {
  id      String @id @default(uuid())
  type    String @unique // "interview_invite", "rejection", "offer"
  subject String
  body    String
}

model SmtpConfig {
  id       String  @id @default(uuid())
  host     String
  port     Int     @default(587)
  username String
  password String
  useTls   Boolean @default(true)
  fromName String  @default("SmartATS")
}
