<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart ATS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar d-flex flex-column">
        <div class="px-4 pb-4 border-bottom mb-3 text-center">
            <h4 class="fw-bold text-primary mb-0"><i class="bi bi-rocket-takeoff"></i> Smart ATS</h4>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mt-2">AI-Powered</span>
        </div>
        
        <ul class="nav flex-column mb-auto">
            <li class="nav-item">
                <a href="/Pipeline" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Pipeline" ? "active" : "")">
                    <i class="bi bi-kanban me-2"></i> Bảng Tuyển Dụng
                </a>
            </li>
            <li class="nav-item mt-2">
                <a href="#" class="nav-link" style="opacity: 0.6; cursor: not-allowed;" title="Tính năng đang phát triển">
                    <i class="bi bi-briefcase me-2"></i> Vị Trí Tuyển Dụng
                </a>
            </li>
             <li class="nav-item mt-2">
                <a href="#" class="nav-link" style="opacity: 0.6; cursor: not-allowed;" title="Tính năng đang phát triển">
                    <i class="bi bi-people me-2"></i> Hồ Sơ Ứng Viên
                </a>
            </li>
            <li class="nav-item mt-2">
                <a href="#" class="nav-link" style="opacity: 0.6; cursor: not-allowed;" title="Tính năng đang phát triển">
                    <i class="bi bi-graph-up me-2"></i> Báo Cáo Thống Kê
                </a>
            </li>
        </ul>
        
        <div class="px-4 py-3 border-top mt-auto">
            <div class="d-flex align-items-center">
                <img src="https://ui-avatars.com/api/?name=HR+Admin&background=eff6ff&color=2563eb" alt="User" class="rounded-circle me-3" width="40" height="40">
                <div>
                    <strong class="d-block text-dark" style="font-size: 0.9rem;">HR Admin</strong>
                    <span class="text-muted" style="font-size: 0.8rem;">hr@company.com</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <header class="top-navbar justify-content-between">
            <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light rounded-circle p-2 position-relative">
                    <i class="bi bi-bell"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                        <span class="visually-hidden">New alerts</span>
                    </span>
                </button>
                 <button class="btn btn-primary btn-sm px-4 rounded-pill fw-medium shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Tạo Mới
                </button>
            </div>
        </header>

        <main role="main" class="p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
