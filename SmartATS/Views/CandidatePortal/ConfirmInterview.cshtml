@model SmartATS.Models.Entities.InterviewToken
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác nhận Lời mời Phỏng vấn - Smart ATS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="card shadow border-0 rounded-4 overflow-hidden">
                    <div class="bg-primary p-4 text-white text-center">
                        <h2 class="fw-bold mb-1">🎉 Lời Mời Phỏng Vấn</h2>
                        <p class="mb-0 opacity-75">Smart ATS - Cầu nối cơ hội nghề nghiệp</p>
                    </div>
                    <div class="card-body p-4 p-md-5 text-center">
                        <p class="lead mb-3">Xin chào <strong>@Model.Application.Candidate.FullName</strong>,</p>
                        <p class="text-muted mb-4">
                            Bộ phận Tuyển dụng trân trọng kính mời bạn tham gia buổi phỏng vấn cho vị trí:
                            <br /><span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-5 mt-2">@Model.Application.Job.Title</span>
                        </p>
                        
                        <div class="alert alert-warning border-0 rounded-3 mb-4 text-start small">
                            ⏱️ <strong>Lưu ý:</strong> Link xác nhận này là duy nhất (Magic Link) và có hiệu lực đến <strong>@Model.ExpirationDate.ToString("HH:mm - dd/MM/yyyy")</strong>.
                        </div>

                        <form method="post" action="/CandidatePortal/ProcessConfirmation">
                            <input type="hidden" name="token" value="@Model.TokenString" />
                            <button type="submit" class="btn btn-success btn-lg w-100 py-3 rounded-pill fw-bold shadow-sm">
                                ✅ Tôi xác nhận tham gia buổi phỏng vấn
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
