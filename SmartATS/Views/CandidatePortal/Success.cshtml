@model SmartATS.Models.Entities.InterviewToken
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác nhận Thành Công - Smart ATS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100">
    <div class="container text-center py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-4 p-5">
                    <div class="display-1 text-success mb-3">✓</div>
                    <h2 class="fw-bold text-dark">Xác nhận Thành Công!</h2>
                    <p class="text-muted mt-2">
                        Cảm ơn bạn <strong>@Model.Application.Candidate.FullName</strong> đã phản hồi.<br/>
                        Hệ thống đã cập nhật trạng thái hồ sơ của bạn cho vị trí <strong>@Model.Application.Job.Title</strong>.
                    </p>
                    <p class="text-muted small">Bộ phận nhân sự (HR) sẽ liên hệ qua email và số điện thoại của bạn với lịch trình chi tiết.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
